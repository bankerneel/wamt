#!/bin/sh
# Start, stop or check Who Ate My Tokens on this Mac.
# Usage: scripts/wamt start | stop | restart | status | open | logs | build
#        scripts/wamt login on | off | status   (start at login via launchd)
#        scripts/wamt statusline on | off | status
set -eu
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BIN="$ROOT/target/release/wamt"
STATE=${WAMT_STATE:-$ROOT/.state}
PIDF="$STATE/wamt.pid"
LOG="$STATE/wamt.log"
URL="http://127.0.0.1:7317"
LABEL="io.github.bankerneel.wamt"
PLIST="$HOME/Library/LaunchAgents/$LABEL.plist"
DOMAIN="gui/$(id -u)"

# When the login item is on, launchd owns the process and the pid file is unused.
loaded() { launchctl print "$DOMAIN/$LABEL" >/dev/null 2>&1; }
pid() {
  if loaded; then launchctl print "$DOMAIN/$LABEL" 2>/dev/null | awk '$1 == "pid" && $2 == "=" { print $3; exit }'
  elif [ -f "$PIDF" ]; then cat "$PIDF"; fi
}
running() { p="$(pid)"; [ -n "$p" ] && kill -0 "$p" 2>/dev/null; }

write_plist() {
  mkdir -p "$(dirname "$PLIST")" "$STATE"
  cat >"$PLIST" <<PL
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$LABEL</string>
  <key>ProgramArguments</key><array><string>$BIN</string></array>
  <key>EnvironmentVariables</key><dict><key>WAMT_STATE</key><string>$STATE</string></dict>
  <key>WorkingDirectory</key><string>$ROOT</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>$LOG</string>
  <key>StandardErrorPath</key><string>$LOG</string>
</dict>
</plist>
PL
}

case "${1:-status}" in
  build)
    cd "$ROOT" && cargo build --release
    ;;
  start)
    if running; then echo "Already running (pid $(pid)) at $URL"; exit 0; fi
    [ -x "$BIN" ] || { echo "Not built yet. Run: $0 build"; exit 1; }
    if loaded; then
      launchctl kickstart "$DOMAIN/$LABEL"; sleep 1
      if running; then echo "Started by launchd (pid $(pid)) at $URL"; else echo "Failed to start. Last log lines:"; tail -n 5 "$LOG"; exit 1; fi
      exit 0
    fi
    mkdir -p "$STATE"
    # A fresh log on every start keeps it small.
    WAMT_STATE="$STATE" nohup "$BIN" >"$LOG" 2>&1 </dev/null &
    echo $! >"$PIDF"
    sleep 1
    if running; then
      echo "Started (pid $(cat "$PIDF")) at $URL"
    else
      echo "Failed to start. Last log lines:"; tail -n 5 "$LOG"; rm -f "$PIDF"; exit 1
    fi
    ;;
  stop)
    if loaded; then
      if running; then launchctl kill SIGTERM "$DOMAIN/$LABEL"; echo "Stopped (starts again at next login)"; else echo "Not running"; fi
    elif running; then kill "$(pid)"; echo "Stopped"; else echo "Not running"; fi
    rm -f "$PIDF"
    ;;
  restart)
    if loaded; then launchctl kickstart -k "$DOMAIN/$LABEL"; sleep 1; echo "Restarted by launchd (pid $(pid))"; else "$0" stop; "$0" start; fi
    ;;
  login)
    case "${2:-status}" in
      on)
        [ -x "$BIN" ] || { echo "Not built yet. Run: $0 build"; exit 1; }
        # Hand over from a manually started copy so the port is free.
        if ! loaded && running; then kill "$(pid)"; rm -f "$PIDF"; sleep 1; fi
        loaded && launchctl bootout "$DOMAIN/$LABEL" 2>/dev/null || true
        write_plist
        : >"$LOG"
        launchctl bootstrap "$DOMAIN" "$PLIST"
        sleep 1
        if running; then echo "Starts at login now, and is running (pid $(pid)) at $URL"; echo "Turn off: $0 login off"
        else echo "Loaded, but not running. Last log lines:"; tail -n 5 "$LOG"; exit 1; fi
        ;;
      off)
        if loaded; then launchctl bootout "$DOMAIN/$LABEL"; fi
        rm -f "$PLIST"
        echo "No longer starts at login, and is stopped. Start by hand: $0 start"
        ;;
      status)
        if loaded; then echo "Starts at login ($PLIST)"; else echo "Does not start at login"; fi
        ;;
      *) echo "Usage: $0 login on | off | status"; exit 2 ;;
    esac
    ;;
  statusline)
    # Only the statusLine command is ever shown; settings.json may hold tokens.
    SETTINGS="$HOME/.claude/settings.json"
    BACKUP="$STATE/settings.json.bak"
    ORIGINAL="$STATE/statusline-orig.json"
    CMD="sh $ROOT/scripts/statusline.sh"
    case "${2:-status}" in
      on)
        [ -f "$SETTINGS" ] || { echo "No settings file at ~/.claude/settings.json"; exit 1; }
        command -v python3 >/dev/null 2>&1 || { echo "python3 is needed for this"; exit 1; }
        mkdir -p "$STATE"
        [ -f "$BACKUP" ] || cp "$SETTINGS" "$BACKUP"
        python3 - "$SETTINGS" "$ORIGINAL" "$CMD" <<'PY'
import json, os, sys
path, orig_path, cmd = sys.argv[1:4]
with open(path, encoding="utf-8") as f:
    settings = json.load(f)
if not os.path.exists(orig_path):
    saved = settings.get("statusLine") if isinstance(settings.get("statusLine"), dict) else {"command": ""}
    with open(orig_path + ".tmp", "w", encoding="utf-8") as f:
        json.dump(saved, f, indent=2)
        f.write("\n")
    os.replace(orig_path + ".tmp", orig_path)
line = settings.get("statusLine")
if not isinstance(line, dict):
    line = {"type": "command"}
line["command"] = cmd
settings["statusLine"] = line
with open(path + ".tmp", "w", encoding="utf-8") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
os.replace(path + ".tmp", path)
PY
        echo "Status line runs WAMT: $CMD"
        echo "Turn off: $0 statusline off"
        ;;
      off)
        [ -f "$ORIGINAL" ] || { echo "No saved status line to restore"; exit 1; }
        command -v python3 >/dev/null 2>&1 || { echo "python3 is needed for this"; exit 1; }
        python3 - "$SETTINGS" "$ORIGINAL" <<'PY'
import json, os, sys
path, orig_path = sys.argv[1:3]
with open(orig_path, encoding="utf-8") as f:
    saved = json.load(f)
settings = {}
if os.path.exists(path):
    with open(path, encoding="utf-8") as f:
        settings = json.load(f)
settings["statusLine"] = saved
with open(path + ".tmp", "w", encoding="utf-8") as f:
    json.dump(settings, f, indent=2)
    f.write("\n")
os.replace(path + ".tmp", path)
PY
        echo "Original status line restored."
        ;;
      status)
        cmd=
        if [ -f "$SETTINGS" ]; then
          cmd=$(python3 - "$SETTINGS" <<'PY'
import json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as f:
        line = json.load(f).get("statusLine") or {}
    print(line.get("command", "") if isinstance(line, dict) else "")
except Exception:
    pass
PY
          )
        fi
        if [ "$cmd" = "$CMD" ]; then
          echo "Active: $CMD"
        else
          echo "Inactive (statusLine command: ${cmd:-none})"
        fi
        ;;
      *) echo "Usage: $0 statusline on | off | status"; exit 2 ;;
    esac
    ;;
  status)
    if running; then
      pid="$(pid)"
      echo "Running (pid $pid) at $URL$(loaded && echo ', managed by launchd')"
      ps -o rss=,%cpu= -p "$pid" | awk '{printf "Resident memory %.1f MB, CPU %s%%\n", $1/1024, $2}'
    else
      echo "Not running"
    fi
    ;;
  open)
    open "$URL"
    ;;
  logs)
    tail -n 40 "$LOG"
    ;;
  *)
    echo "Usage: $0 start | stop | restart | status | open | logs | build | login on|off|status | statusline on|off|status"; exit 2
    ;;
esac
