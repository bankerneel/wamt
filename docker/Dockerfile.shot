# Headless Chromium for screenshot checks of the page during testing only.
FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends chromium fonts-inter fonts-roboto fonts-dejavu-core ca-certificates \
 && rm -rf /var/lib/apt/lists/*
ENTRYPOINT ["chromium", "--headless=new", "--no-sandbox", "--disable-gpu", "--hide-scrollbars", "--disable-dev-shm-usage"]
